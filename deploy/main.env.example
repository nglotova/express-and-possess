# Copy to main.env and fill in. Never commit main.env.
DOMAIN=expresspossess.glotov.ca
DB_PASSWORD=change-me
KAFKA_CLUSTER_ID=main-00000000000000000
# Whoever registers with one of these addresses gets the administration page.
ADMIN_EMAILS=you@glotov.ca
# Brevo's SMTP relay. The login and the SMTP key are on Brevo's "SMTP & API" page.
# The name inboxes show, and a subdomain of its own, so the site's email reputation stays apart
# from the mailboxes at glotov.ca.
MAIL_FROM=Express & Possess <no-reply@notify.glotov.ca>
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_AUTH=true
MAIL_STARTTLS=true
DEMO=false
